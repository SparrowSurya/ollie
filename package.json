{
  "name": "olly",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "db:prepare": "bun scripts/prepare-prisma.ts && prisma generate",
    "db:push": "bun scripts/prepare-prisma.ts && prisma db push",
    "dev": "bun db:prepare && bun --bun next dev",
    "build": "bun db:prepare && bun --bun next build",
    "start": "bun --bun next start",
    "lint": "eslint"
  },
  "dependencies": {
    "@catppuccin/daisyui": "^2.1.1",
    "@langchain/core": "^1.2.1",
    "@langchain/langgraph": "^1.4.7",
    "@langchain/ollama": "^1.3.0",
    "@libsql/client": "^0.17.4",
    "@prisma/adapter-libsql": "^7.8.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "7",
    "highlight.js": "^11.11.1",
    "katex": "^0.17.0",
    "langchain": "^1.5.2",
    "lucide-react": "^1.22.0",
    "marked": "^18.0.5",
    "marked-katex-extension": "^5.1.10",
    "next": "16.2.9",
    "pg": "^8.22.0",
    "postgres": "^3.4.9",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.1",
    "@types/marked": "^6.0.0",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "bun-types": "^1.3.14",
    "daisyui": "^5.6.7",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "prisma": "7",
    "tailwindcss": "4.3.1",
    "typescript": "^5"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
